<Window x:Class="FreeCom.App.SetAxisRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置坐标轴显示窗口" Height="436" Width="410"
        WindowStartupLocation="CenterOwner" Background="#FF20252B" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="X 轴（横轴）显示窗口" Foreground="#FFE8E8E8" FontWeight="Bold" Margin="0,0,0,6"/>
        <RadioButton x:Name="RbXAuto" Content="自动（跟随全部数据）" GroupName="XMode"
                     Foreground="#FFD6E2EE" IsChecked="True" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="RbXWindow" GroupName="XMode" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="滚动窗口：显示最近" Foreground="#FFD6E2EE" VerticalAlignment="Center"/>
                <TextBox x:Name="TbXPoints" Width="64" FontFamily="Consolas" Margin="6,0,0,0" Text="500"
                         ToolTip="窗口内始终显示最新 N 个点：新点从右侧进入，最老的点从左侧移出"/>
                <TextBlock Text="个点" Foreground="#FF9AB0C0" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="示波器滚动方式：新点从右侧进入，最老的点从左侧移出；数据不足 N 点时曲线从左侧开始生长"
                   Foreground="#FF9AB0C0" FontSize="11" Margin="26,0,0,8" TextWrapping="Wrap"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="RbXFixed" GroupName="XMode" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="固定范围" Foreground="#FFD6E2EE"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="最小" Foreground="#FF9AB0C0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TbXMin" Width="90" FontFamily="Consolas" Margin="6,0,0,0"/>
                    <TextBlock Text="最大" Foreground="#FF9AB0C0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="TbXMax" Width="90" FontFamily="Consolas" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <TextBlock Text="Y 轴（纵轴）显示窗口" Foreground="#FFE8E8E8" FontWeight="Bold" Margin="0,0,0,6"/>
        <RadioButton x:Name="RbYAuto" Content="自动（跟随数据）" GroupName="YMode"
                     Foreground="#FFD6E2EE" IsChecked="True" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="RbYFixed" GroupName="YMode" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="固定窗口（超出窗口的数据被裁剪出画面，像示波器）" Foreground="#FFD6E2EE"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="最小" Foreground="#FF9AB0C0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TbYMin" Width="90" FontFamily="Consolas" Margin="6,0,0,0"/>
                    <TextBlock Text="最大" Foreground="#FF9AB0C0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="TbYMax" Width="90" FontFamily="Consolas" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="TbHint" Foreground="#FFFF7A50" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="应用" Width="90" Margin="0,0,8,0" Click="Apply_OnClick"/>
            <Button Content="取消" Width="60" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
