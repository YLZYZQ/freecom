<Window x:Class="FreeCom.App.DeviceSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备模拟器（下位机）" Height="440" Width="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="以“下位机”身份打开虚拟串口对的另一端，持续发送协议帧或手动发送数据。"
                       FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="1,0,0,10"/>

            <!-- 参数卡 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="端口"/>
                            <ComboBox x:Name="CbPort" Width="120" FontFamily="Consolas, Courier New"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="协议"/>
                                    <ComboBox x:Name="CbProtocol" Width="116" FontFamily="Consolas, Courier New"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="间隔(ms)"/>
                                    <TextBox x:Name="TbInterval" Width="72" Text="100" FontFamily="Consolas, Courier New"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnStart" Content="▶ 开始发送" Width="104" Style="{StaticResource PrimaryButton}" Click="Start_OnClick"/>
                            <Button Content="刷新" Width="54" Margin="8,0,0,0" Click="ReloadPorts_OnClick"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TbState" Text="● 未连接" FontSize="11" FontFamily="Consolas"
                               Foreground="{DynamicResource TextMuted}" Margin="1,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 手动发送 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="TbManual" Width="340" Height="32" FontFamily="Consolas, Courier New"/>
                <RadioButton x:Name="RbText" Content="文本" Style="{StaticResource SegmentItem}" GroupName="m"
                             IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="RbHex" Content="HEX" Style="{StaticResource SegmentItem}" GroupName="m"
                             Margin="6,0,0,0" VerticalAlignment="Center"/>
                <Button Content="手动发送" Width="88" Style="{StaticResource AccentGhostButton}"
                        Margin="10,0,0,0" Click="Manual_OnClick" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- 发送日志 -->
        <StackPanel>
            <TextBlock Style="{StaticResource SectionLabel}" Text="发 送 日 志"/>
            <TextBox x:Name="TbLog" IsReadOnly="True" FontFamily="Consolas, Courier New" FontSize="12"
                     Background="{DynamicResource CodeBrush}" Foreground="{DynamicResource CodeTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </DockPanel>
</Window>
