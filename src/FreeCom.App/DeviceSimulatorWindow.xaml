<Window x:Class="FreeCom.App.DeviceSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备模拟器（下位机）" Height="330" Width="560"
        WindowStartupLocation="CenterOwner" Background="#FF20252B">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="以“下位机”身份打开虚拟串口对的另一端，持续发送协议帧或手动发送数据。"
                       Foreground="#FF9AB0C0" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="端口:" Foreground="#FFE8E8E8" VerticalAlignment="Center"/>
                <ComboBox x:Name="CbPort" Width="110" Margin="6,0,0,0" Foreground="Black"/>
                <TextBlock Text="协议:" Foreground="#FFE8E8E8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ComboBox x:Name="CbProtocol" Width="110" Foreground="Black"/>
                <TextBlock Text="间隔(ms):" Foreground="#FFE8E8E8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox x:Name="TbInterval" Width="60" Text="100" FontFamily="Consolas"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BtnStart" Content="开始发送" Width="80" Click="Start_OnClick"/>
                <Button Content="刷新端口" Width="74" Margin="8,0,0,0" Click="ReloadPorts_OnClick"/>
                <TextBlock x:Name="TbState" Text="状态: 未连接" Foreground="#FF9AB0C0" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TbManual" Width="360" Height="30" FontFamily="Consolas"
                         VerticalContentAlignment="Center"/>
                <RadioButton x:Name="RbText" Content="文本" IsChecked="True" Foreground="#FFE8E8E8" VerticalAlignment="Center" Margin="8,0,0,0" GroupName="m"/>
                <RadioButton x:Name="RbHex" Content="HEX" Foreground="#FFE8E8E8" VerticalAlignment="Center" Margin="6,0,0,0" GroupName="m"/>
                <Button Content="手动发送" Width="74" Margin="8,0,0,0" Click="Manual_OnClick"/>
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="TbLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Background="#FF101317" Foreground="#FFD6E2EE" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
