<Window x:Class="FreeCom.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}">
    <StackPanel Margin="28,26,28,22">
        <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource AccentBrush}"
                HorizontalAlignment="Center">
            <TextBlock Text="F" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource AccentTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="FreeCom" FontSize="20" FontWeight="Bold" Margin="0,14,0,2"
                   Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TbVersion" Text="免费串口调试助手 · v0.1" FontSize="11" Margin="0,0,0,14"
                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Border CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="10,3" Margin="0,0,8,0">
                <TextBlock Text="MIT 开源" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
            </Border>
            <Border CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,3">
                <TextBlock x:Name="TbRepo" Text="GitHub ↗" FontSize="10" Cursor="Hand"
                           Foreground="{DynamicResource AccentBrush}"
                           MouseLeftButtonUp="Repo_OnMouseUp"/>
            </Border>
        </StackPanel>
        <TextBlock Text="全功能免费 · 无账户 · 无授权" FontSize="10.5" Margin="0,0,0,18"
                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
        <Button Content="确定" Width="84" Height="30" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Center" IsDefault="True" IsCancel="True"/>
    </StackPanel>
</Window>
