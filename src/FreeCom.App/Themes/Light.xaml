<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 亮色主题色板（设计稿 v2）：与 Dark.xaml 键完全一致，仅值不同 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#C9D1DB"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E4E8EE"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EDF0F4"/>
