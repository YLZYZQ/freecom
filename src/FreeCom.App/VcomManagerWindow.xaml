<Window x:Class="FreeCom.App.VcomManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="虚拟串口管理器（com0com）" Height="480" Width="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <DockPanel Margin="16">
        <!-- 驱动状态卡 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="下载与安装说明" Height="24" FontSize="11"
                        Click="Help_OnClick" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DotDriver" Width="9" Height="9" Fill="{DynamicResource TextMuted}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TbDriver" Text="驱动状态：检测中..." FontSize="11.5"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 底部操作 -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="ⓘ 创建 / 删除端口对需要管理员权限，将弹出 UAC 确认" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" Margin="1,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="＋ 创建一对" Width="100" Style="{StaticResource PrimaryButton}" Click="Create_OnClick"/>
                    <Button Content="删除所选" Width="88" Margin="8,0,0,0" Click="Remove_OnClick"/>
                    <Button Content="刷新" Width="64" Margin="8,0,0,0" Click="Reload_OnClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 端口对列表 -->
        <StackPanel>
            <TextBlock Style="{StaticResource SectionLabel}" Text="端 口 对"/>
            <ListBox x:Name="LbPairs" FontFamily="Consolas, Courier New" FontSize="13" MinHeight="220"/>
        </StackPanel>
    </DockPanel>
</Window>
