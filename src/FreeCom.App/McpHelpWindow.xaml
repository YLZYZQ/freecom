<Window x:Class="FreeCom.App.McpHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCP AI 自动化说明"
        Icon="/freecom.ico" Height="700" Width="860"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="NavList" Grid.Column="0" SelectionChanged="Nav_OnSelectionChanged"
                 FontFamily="Consolas, Courier New" FontSize="13"/>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentHost" Margin="4,0,0,0"/>
        </ScrollViewer>
    </Grid>
</Window>
