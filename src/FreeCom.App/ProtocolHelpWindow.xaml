<Window x:Class="FreeCom.App.ProtocolHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="协议格式说明"
        Icon="/freecom.ico" Height="680" Width="800"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- 左侧协议导航 -->
        <ListBox x:Name="NavList" Grid.Column="0" SelectionChanged="Nav_OnSelectionChanged"
                 FontFamily="Consolas, Courier New" FontSize="13"/>
        <!-- 右侧内容（按协议切换的面板挂在 ContentHost 下） -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentHost" Margin="4,0,0,0"/>
        </ScrollViewer>
    </Grid>
</Window>
